# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Client-side Firebase config (project id, api key, database id) is NOT here:
# it lives in the committed firebase-applet-config.json.

# APP_URL: The public URL of your application (e.g. https://guardiancheck.co.za)
# Used for invitation links, payment redirects and verification email links.
# Note: server.ts reads APP_URL; vite.config.ts reads VITE_APP_URL and falls
# back to APP_URL. Set both if you change the origin.
APP_URL="https://guardiancheck.co.za"
VITE_APP_URL="https://guardiancheck.co.za"

# Firebase Admin (server-side) — from your Firebase Service Account JSON.
# The app will not start without these.
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend — the only email transport. Sends verification and invitation mail
# (emailService.ts) and check-in/check-out/room-move/emergency notifications
# (notifications/providers/email.ts).
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="notifications@guardiancheck.co.za"

# Shared secret Vercel Cron sends as a bearer token when it triggers
# POST /api/cron/notifications-sweep (see vercel.json's `crons` block). Not
# set -> the route always 401s, so this must be set for the sweep to ever run.
CRON_SECRET="a-long-random-string"

# Off by default. The MVP notification recipient is the account-holding
# parent only (see docs/whatsapp-communication-plan.md section 3, decision
# P5) -- guardians are never sent anything yet, pending consent + phone
# verification. Setting this to "true" also notifies any guardian record
# that has an email on file.
NOTIFY_GUARDIANS=false

# PayFast (server-side)
PAYFAST_PASSPHRASE="your_passphrase"
PAYFAST_SANDBOX=true

# PayFast (client-side — must be prefixed VITE_ to reach the browser)
VITE_PAYFAST_MERCHANT_ID="10000100"
VITE_PAYFAST_MERCHANT_KEY="46f0cd694581a"
VITE_PAYFAST_SANDBOX=true

# DEV MODE: verbose console logging and sandboxed external services.
VITE_DEV_MODE=false

# Firebase App Check (reCAPTCHA Enterprise). Optional locally — App Check is
# only initialised when this is set (src/lib/firebase.ts).
VITE_RECAPTCHA_SITE_KEY="your-recaptcha-enterprise-site-key"

# Monitoring & alerts
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
