# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_APP_URL: The public URL of your application (e.g., https://guardiancheck.co.za)
# This is used for invitation links, payment redirects, and verification emails.
# this is also for payment redirect
VITE_APP_URL="https://guardiancheck.co.za"

# Resend Configuration
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="notifications@guardiancheck.co.za"
PAYFAST_PASSPHRASE="your_passphrase"
PAYFAST_SANDBOX=true

# PayFast Configuration (Client-side - must start with VITE_)
VITE_PAYFAST_MERCHANT_ID="10000100"
VITE_PAYFAST_MERCHANT_KEY="46f0cd694581a"
VITE_PAYFAST_SANDBOX=true

# DEV MODE: Set to true to enable detailed console logs and use sandboxes for external services
VITE_DEV_MODE=false

# Firebase Admin (Server-side)
# Get these from your Firebase Service Account JSON
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@guardiancheck.com"

# App Check Configuration
VITE_RECAPTCHA_SITE_KEY="your-recaptcha-enterprise-site-key"

# Monitoring & Alerts
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Firebase Client (Required for token generation scripts)
VITE_FIREBASE_API_KEY="your-web-api-key"
