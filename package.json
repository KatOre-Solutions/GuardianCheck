{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "build": "npm run check:vercel-routes && npm run check:firebase-db && vite build && npm run generate:sitemap && npm run generate:llms-txt && esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:llms-txt": "tsx scripts/generate-llms-txt.ts",
    "generate:vercel-routes": "tsx scripts/generate-vercel-routes.ts",
    "check:vercel-routes": "tsx scripts/generate-vercel-routes.ts --check",
    "check:firebase-db": "tsx scripts/check-firebase-db.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project gc-rules-test \"node tests/firestore-rules.test.mjs && node tests/firestore-churches.test.mjs && node tests/firestore-children-directory.test.mjs && node tests/firestore-checkins.test.mjs && node tests/firestore-church-public.test.mjs && node tests/firestore-invitations.test.mjs && node tests/firestore-notifications.test.mjs\"",
    "test:pin-limiter": "node tests/pin-limiter.test.mjs",
    "test:checkout": "node tests/checkout-endpoints.test.mjs",
    "test:notifications": "tsx tests/notifications-service.test.mjs",
    "test:email-provider": "tsx tests/email-provider-result.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.14.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "he": "^1.2.0",
    "helmet": "^8.1.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cache": "^5.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.0",
    "resend": "^6.12.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/he": "^1.2.3",
    "@types/node": "^22.14.0",
    "@types/node-cache": "^4.1.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
