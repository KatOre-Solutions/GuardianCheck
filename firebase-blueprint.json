{
  "entities": {
    "invitation": {
      "title": "Invitation",
      "description": "Secure invitation for new users",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "volunteer", "parent"] },
        "churchId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "expired"] },
        "token": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "invitedBy": { "type": "string" }
      },
      "required": ["email", "role", "churchId", "status", "token", "expiresAt"]
    },
    "church": {
      "title": "Church",
      "description": "Church organization details and SaaS configuration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string", "description": "Unique URL-friendly identifier" },
        "address": { "type": "string" },
        "adminEmail": { "type": "string" },
        "branding": {
          "type": "object",
          "properties": {
            "logoUrl": { "type": "string" },
            "primaryColor": { "type": "string" },
            "secondaryColor": { "type": "string" }
          }
        },
        "subscription": {
          "type": "object",
          "properties": {
            "tier": { "type": "string", "enum": ["free", "pro", "enterprise"] },
            "status": { "type": "string", "enum": ["active", "past_due", "canceled", "trialing"] },
            "trialStartedAt": { "type": "string", "format": "date-time" },
            "trialEndsAt": { "type": "string", "format": "date-time" },
            "billingDate": { "type": "string", "format": "date-time" },
            "payfast_token": { "type": "string" }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "totalChildren": { "type": "number" },
            "activeCheckins": { "type": "number" },
            "totalVolunteers": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "adminEmail"]
    },
    "membershipRequest": {
      "title": "MembershipRequest",
      "description": "Request to join a church",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "churchId": { "type": "string" },
        "churchName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "churchId", "status"]
    },
    "room": {
      "title": "Room",
      "description": "A room or group for children",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "capacity": { "type": "number" },
        "minAge": { "type": "number" },
        "maxAge": { "type": "number" },
        "churchId": { "type": "string" }
      },
      "required": ["name", "capacity", "minAge", "maxAge", "churchId"]
    },
    "child": {
      "title": "Child",
      "description": "Child information",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "age": { "type": "number" },
        "allergies": { "type": "string" },
        "notes": { "type": "string" },
        "parentId": { "type": "string" },
        "qrCode": { "type": "string" },
        "photoUrl": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "churchId": { "type": "string" }
      },
      "required": ["firstName", "lastName", "age", "parentId", "churchId"]
    },
    "guardian": {
      "title": "Guardian",
      "description": "Authorized guardian for a child",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phone": { "type": "string" },
        "relationship": { "type": "string" },
        "idNumber": { "type": "string" },
        "photoUrl": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "childIds": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "qrToken": { "type": "string" },
        "active": { "type": "boolean" },
        "parentId": { "type": "string" },
        "churchId": { "type": "string" }
      },
      "required": ["firstName", "lastName", "phone", "relationship", "childIds", "qrToken", "active", "parentId", "churchId"]
    },
    "parent": {
      "title": "Parent",
      "description": "Parent information",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "uid": { "type": "string" },
        "churchId": { "type": "string" }
      },
      "required": ["firstName", "lastName", "phone", "email", "uid", "churchId"]
    },
    "checkIn": {
      "title": "CheckIn",
      "description": "Check-in and check-out records",
      "type": "object",
      "properties": {
        "childId": { "type": "string" },
        "childName": { "type": "string", "description": "Full name for display" },
        "roomId": { "type": "string" },
        "roomName": { "type": "string" },
        "checkInTime": { "type": "string", "format": "date-time" },
        "checkOutTime": { "type": "string", "format": "date-time" },
        "volunteerId": { "type": "string" },
        "volunteerName": { "type": "string" },
        "checkOutVolunteerId": { "type": "string" },
        "checkOutVolunteerName": { "type": "string" },
        "guardianId": { "type": "string" },
        "guardianName": { "type": "string" },
        "checkedInBy": { "type": "string" },
        "status": { "type": "string", "enum": ["checked-in", "checked-out"] },
        "overrideReason": { "type": "string" },
        "churchId": { "type": "string" }
      },
      "required": ["childId", "roomId", "checkInTime", "status", "churchId"]
    },
    "user": {
      "title": "User",
      "description": "App user roles and profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": { "type": "string", "enum": ["master_admin", "admin", "volunteer", "parent"] },
        "churchId": { "type": "string" },
        "status": { "type": "string", "enum": ["incomplete_profile", "pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "photoUrl": { "type": "string" },
        "darkMode": { "type": "boolean" }
      },
      "required": ["uid", "email", "status"]
    },
    "policyAcceptance": {
      "title": "PolicyAcceptance",
      "description": "Summary of user's latest policy acceptance",
      "type": "object",
      "properties": {
        "lastAcceptedVersion": { "type": "string" },
        "lastAcceptedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["compliant", "outdated"] }
      },
      "required": ["lastAcceptedVersion", "lastAcceptedAt", "status"]
    },
    "policyAcceptanceHistory": {
      "title": "PolicyAcceptanceHistory",
      "description": "Immutable audit record of a specific policy acceptance",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "churchId": { "type": "string" },
        "roleAtTime": { "type": "string" },
        "legalContext": {
          "type": "object",
          "properties": {
            "policyHash": { "type": "string" },
            "agreementType": { "type": "string", "enum": ["Operator_Agreement", "Privacy_Notice"] }
          }
        },
        "forensicData": {
          "type": "object",
          "properties": {
            "userAgent": { "type": "string" },
            "ipMasked": { "type": "string" },
            "traceId": { "type": "string" }
          }
        },
        "acceptanceMethod": { "type": "string" }
      },
      "required": ["version", "acceptedAt", "churchId", "roleAtTime", "legalContext"]
    },
    "churchPolicyAcceptance": {
      "title": "ChurchPolicyAcceptance",
      "description": "Organization-level acceptance of Data Processing Agreement",
      "type": "object",
      "properties": {
        "acceptedBy": { "type": "string" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "policyVersion": { "type": "string" }
      },
      "required": ["acceptedBy", "acceptedAt", "policyVersion"]
    },
    "log": {
      "title": "Log",
      "description": "Application logs for debugging and monitoring",
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["info", "warn", "error", "critical"] },
        "message": { "type": "string" },
        "context": { "type": "object" },
        "userId": { "type": "string" },
        "churchId": { "type": "string" },
        "source": { "type": "string", "enum": ["client", "server"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "stack": { "type": "string" },
        "url": { "type": "string" },
        "userAgent": { "type": "string" }
      },
      "required": ["level", "message", "timestamp", "source"]
    },
    "emailLog": {
      "title": "EmailLog",
      "description": "History of sent emails and their delivery status",
      "type": "object",
      "properties": {
        "recipientEmail": { "type": "string" },
        "subject": { "type": "string" },
        "eventType": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "failed"] },
        "errorMessage": { "type": "string" },
        "churchId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "provider": { "type": "string" },
        "messageId": { "type": "string" }
      },
      "required": ["recipientEmail", "subject", "status", "timestamp"]
    },
    "audit_log": {
      "title": "AuditLog",
      "description": "Critical security and data change records",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "category": { "type": "string" },
        "details": { "type": "object" },
        "churchId": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ip": { "type": "string" }
      },
      "required": ["action", "category", "timestamp"]
    },
    "metricDaily": {
      "title": "MetricDaily",
      "description": "Daily aggregated metrics for system health",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "churchId": { "type": "string" },
        "checkinCount": { "type": "number" },
        "errorCount": { "type": "number" },
        "activeUsers": { "type": "number" },
        "emailSentCount": { "type": "number" }
      },
      "required": ["date", "churchId"]
    }
  },
  "firestore": {
    "/users": { "schema": "user", "description": "User roles and permissions" },
    "/churches": { "schema": "church", "description": "Church organizations" },
    "/membershipRequests": { "schema": "membershipRequest", "description": "Requests to join a church" },
    "/children": { "schema": "child", "description": "Children registered in the system" },
    "/guardians": { "schema": "guardian", "description": "Authorized guardians for children" },
    "/rooms": { "schema": "room", "description": "Rooms or groups for children" },
    "/checkins": { "schema": "checkIn", "description": "Check-in and check-out records" },
    "/invitations": { "schema": "invitation", "description": "Secure invitations for new users" },
    "/policy_acceptance/{uid}": { "schema": "policyAcceptance", "description": "User policy acceptance summary" },
    "/policy_acceptance/{uid}/history/{versionId}": { "schema": "policyAcceptanceHistory", "description": "Immutable policy acceptance audit trail" },
    "/church_policy_acceptance/{churchId}": { "schema": "churchPolicyAcceptance", "description": "Church-level DPA acceptance" },
    "/logs": { "schema": "log", "description": "Application execution logs" },
    "/email_logs": { "schema": "emailLog", "description": "Email delivery logs" },
    "/audit_logs": { "schema": "audit_log", "description": "Security audit trails" },
    "/metrics_daily": { "schema": "metricDaily", "description": "Daily system usage metrics" }
  }
}
