rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, role, firstName, lastName, churchId, status, createdAt, updatedAt
    //
    // Collection: churches
    // Fields: name, address, adminEmail, adminOverridePinHash, adminOverridePin, pinLastUpdatedAt, createdAt
    //
    // Collection: audit_logs
    // Fields: action, category, details, churchId, userId, timestamp
    //
    // Collection: membershipRequests
    // Fields: userId, userEmail, userName, churchId, churchName, status, createdAt, updatedAt
    //
    // Collection: children
    // Fields: firstName, lastName, age, allergies, notes, parentId, churchId, createdAt, updatedAt
    //
    // Collection: rooms
    // Fields: name, capacity, minAge, maxAge, churchId, createdAt, updatedAt
    //
    // Collection: guardians
    // Fields: firstName, lastName, phone, relationship, childIds, qrToken, parentId, churchId, active, createdAt, updatedAt
    //
    // Collection: checkins
    // Fields: childId, childName, roomId, roomName, checkInTime, checkOutTime, volunteerId, volunteerName, status, churchId, createdAt, updatedAt
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMasterAdmin() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (('roles' in userData && 'master_admin' in userData.roles) || userData.role == 'master_admin');
    }

    function isApproved() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             userData.status == 'approved';
    }

    function isAdmin() {
      let userData = getUserData();
      return isApproved() && (('roles' in userData && 'admin' in userData.roles) || userData.role == 'admin' || isMasterAdmin());
    }

    function isVolunteer() {
      let userData = getUserData();
      return isApproved() && (('roles' in userData && 'volunteer' in userData.roles) || userData.role == 'volunteer' || isAdmin());
    }

    function isParent() {
      let userData = getUserData();
      return isApproved() && (('roles' in userData && 'parent' in userData.roles) || userData.role == 'parent' || isAdmin());
    }

    function isChurchMember(churchId) {
      return isApproved() && getUserData().churchId == churchId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'status']) &&
             data.uid is string &&
             data.email is string &&
             data.status in ['incomplete_profile', 'pending', 'approved', 'rejected'] &&
             (!('roles' in data) || data.roles is list);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isMasterAdmin() || 
        (isApproved() && resource != null && getUserData().churchId == resource.data.churchId && (isAdmin() || isVolunteer()))
      );
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && (
          // User can update their own profile if incomplete
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().status == 'incomplete_profile' && request.resource.data.status == 'pending') ||
          // User can update their own settings (like darkMode)
          (isApproved() && request.resource.data.status == 'approved' && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) && (!('churchId' in request.resource.data) || request.resource.data.churchId == resource.data.churchId))
        )) ||
        isMasterAdmin() ||
        (isAdmin() && resource != null && (!('role' in resource.data) || resource.data.role != 'master_admin') && (!('churchId' in resource.data) || getUserData().churchId == resource.data.churchId) && (!('churchId' in request.resource.data) || request.resource.data.churchId == getUserData().churchId) && (!('role' in request.resource.data) || request.resource.data.role != 'master_admin'))
      );
      allow delete: if isMasterAdmin();
    }

    match /churches/{churchId} {
      allow read: if isAuthenticated(); // Restrict to authenticated users
      allow create: if isMasterAdmin();
      allow update: if isMasterAdmin() || (isAdmin() && getUserData().churchId == churchId);
      allow delete: if isMasterAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isApproved();
      allow update, delete: if false;
    }

    match /membershipRequests/{requestId} {
      allow read: if isAuthenticated() && (
        (resource != null && request.auth.uid == resource.data.userId) || 
        isMasterAdmin() || 
        (isAdmin() && resource != null && getUserData().churchId == resource.data.churchId)
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId && request.resource.data.status == 'pending';
      allow update: if isMasterAdmin() || (isAdmin() && resource != null && getUserData().churchId == resource.data.churchId);
      allow delete: if isMasterAdmin();
    }

    match /children/{childId} {
      allow read: if isMasterAdmin() || (
        isApproved() && resource != null && getUserData().churchId == resource.data.churchId && 
        (isVolunteer() || isAdmin() || (isParent() && resource.data.parentId == request.auth.uid))
      );
      allow create: if isApproved() && getUserData().churchId == request.resource.data.churchId && (isAdmin() || (isParent() && request.resource.data.parentId == request.auth.uid));
      allow update: if isMasterAdmin() || (
        isApproved() && resource != null && getUserData().churchId == resource.data.churchId && 
        (isAdmin() || isVolunteer() || (isParent() && resource.data.parentId == request.auth.uid))
      );
      allow delete: if isMasterAdmin() || (isAdmin() && resource != null && getUserData().churchId == resource.data.churchId);
    }

    match /guardians/{guardianId} {
      allow read: if isMasterAdmin() || (
        isApproved() && resource != null && getUserData().churchId == resource.data.churchId && 
        (isVolunteer() || isAdmin() || (isParent() && resource.data.parentId == request.auth.uid))
      );
      allow create: if isApproved() && getUserData().churchId == request.resource.data.churchId && (isAdmin() || (isParent() && request.resource.data.parentId == request.auth.uid));
      allow update: if isMasterAdmin() || (
        isApproved() && resource != null && getUserData().churchId == resource.data.churchId && 
        (isAdmin() || isVolunteer() || (isParent() && resource.data.parentId == request.auth.uid))
      );
      allow delete: if isMasterAdmin() || (isAdmin() && resource != null && getUserData().churchId == resource.data.churchId);
    }

    match /rooms/{roomId} {
      allow read: if isMasterAdmin() || (isApproved() && resource != null && getUserData().churchId == resource.data.churchId);
      allow create: if isMasterAdmin() || (isAdmin() && getUserData().churchId == request.resource.data.churchId);
      allow update: if isMasterAdmin() || (isAdmin() && resource != null && getUserData().churchId == resource.data.churchId);
      allow delete: if isMasterAdmin() || (isAdmin() && resource != null && getUserData().churchId == resource.data.churchId);
    }

    match /checkins/{checkinId} {
      allow read: if isMasterAdmin() || (isApproved() && resource != null && getUserData().churchId == resource.data.churchId);
      allow create: if isApproved() && getUserData().churchId == request.resource.data.churchId && (isVolunteer() || isAdmin());
      allow update: if isApproved() && resource != null && getUserData().churchId == resource.data.churchId && (isVolunteer() || isAdmin());
      allow delete: if isMasterAdmin() || (isAdmin() && resource != null && getUserData().churchId == resource.data.churchId);
    }

    match /invitations/{invitationId} {
      allow read: if true; 
      allow create: if isMasterAdmin() || (isAdmin() && getUserData().churchId == request.resource.data.churchId);
      allow update: if isMasterAdmin() || (isAdmin() && resource != null && getUserData().churchId == resource.data.churchId);
      allow delete: if isMasterAdmin() || (isAdmin() && resource != null && getUserData().churchId == resource.data.churchId);
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
