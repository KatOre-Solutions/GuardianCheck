{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(?:login|register-church|accept-invite|complete-profile|pending-approval|rejected|policy-acceptance|admin|volunteer|parent|profile|master-admin|master-admin/logs)/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/[^/]+/(?:login|parent|volunteer|admin)/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/[^/]+/admin/(?:settings|events)/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/[^/]+/?$",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 404
    }
  ]
}
