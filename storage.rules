rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Private images use authenticated server endpoints. Admin SDK operations
    // bypass these client rules after authorization against the named database.
    match /profiles/{userId}/{allPaths=**} {
      allow read, write: if false;
    }
    match /children/{allPaths=**} {
      allow read, write: if false;
    }
    match /guardians/{allPaths=**} {
      allow read, write: if false;
    }
    // Church logos are intentionally shown on public landing pages.
    match /churches/{churchId}/{fileName} {
      allow get: if fileName.matches('^logo_[^/]+$');
      allow list, write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
